# 本地开发 + 容器沙盒集群模式
#
# 用法：cp .env.sandbox.template .env.sandbox && npm run dev:sandbox
# 前置：docker compose -f docker-compose.sandbox.yml up -d
#
# 这份只列**本地开发真正会用到**的项，值都是拷过去就能直接跑起来的默认值。
# 全量配置项与逐条理由见 .env.example；这里只在有坑的地方多说一句。

# ---- 服务 ----
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
# 挂上隔离自检等调试端点。生产必须是 0（NODE_ENV=production 时会拒绝启动）
DEV_CONSOLE=1
# 在 / 提供内置对话界面。改之前记得先 npm run web:build
WEB_UI=1

# ---- 身份 ----
AUTH_MODE=password
CONSOLE_USERS=admin:changeme
# 不设的话密钥每次启动随机生成 —— 表现是**每重启一次就要重新登录一次**
SESSION_SECRET=dev-session-secret
SESSION_TTL_HOURS=24

# ---- 数据落盘 ----
#
# ⚠️ 这一项最容易踩：`SESSION_STORE` 的默认值是 `memory`，意思是
# **对话只在进程内存里，每次重启全部消失**。而记忆、项目、定时任务、作品
# 都落在 DATA_DIR 上活得好好的 —— 于是会出现"作品还在，产出它的那条对话没了"
# 这种看起来像 bug 的现象。本地开发一律用 file。
SESSION_STORE=file
# 默认落在 ~/.ap-cloud-agent。想让数据跟着仓库或换个盘就取消注释（必须是绝对路径）
# DATA_DIR=/absolute/path/to/ap-data

# ---- 大模型 ----
# faux   = 假模型，不发任何外部请求（离线开发用）。⚠️ 它**不会调用任何工具**，
#          所以技能、沙盒、作品这些都验证不了 —— 要验证功能就得用 direct。
# direct = 直连 OpenAI 兼容端点（本地联调真模型）
LLM_MODE=faux

# 取消下面的注释并填入你的模型配置，然后把 LLM_MODE 改为 direct
# LLM_DIRECT_BASE_URL=https://api.openai.com/v1
# LLM_DIRECT_API_KEY=sk-xxx
# LLM_DIRECT_MODEL=gpt-4o-mini,gpt-4o    # 逗号分隔，第一个是默认；大小写敏感
# LLM_DIRECT_INPUT=text,image            # 不含 image 时截图会被静默丢掉
# LLM_DIRECT_CONTEXT_WINDOW=128000
# LLM_DIRECT_MAX_TOKENS=4096

# 模型调用失败时的退避重试（2s / 4s / 8s）
LLM_RETRY_ENABLED=1
LLM_RETRY_MAX=3
LLM_RETRY_BASE_MS=2000

# ---- 沙盒集群 ----
SANDBOX_MODE=manager
SANDBOX_MANAGER_URL=http://localhost:3000
# 必须与 docker-compose.sandbox.yml 里 manager 的 API_SECURITY_CODES 一致，
# 对不上的表现是每次执行命令都被管理端拒签票据
SANDBOX_MANAGER_CODE=dev-api-code
SANDBOX_POOL=default
SANDBOX_TIMEOUT_MS=120000
# 持有租约期间周期性续期。关掉的话，模型长思考十几分钟就会撞上 idle 回收，
# 回来时工作区已经没了
SANDBOX_KEEPALIVE=1
# 命令走异步任务 + 断线续传。关掉退回同步流，网络抖一下长命令就白跑
SANDBOX_EXEC_ASYNC=1
# 一轮结束后是否驻留沙盒：auto = 只在这一轮真的用过浏览器时留（下一轮登录态还在）
SANDBOX_PARK=auto
# 要求节点具备浏览器能力。本地就一个 worker，不用挑
SANDBOX_NEED_BROWSER=0
# ⚠️ 默认关。开了之后沙盒里模型现写的代码能读到你的 me_token，
# 而触发它只需要一封诱导邮件（prompt injection）
SANDBOX_INJECT_ME_TOKEN=0

# ---- 技能 ----
#
# ⚠️ 冒号分隔。**Windows 上不要写绝对路径** —— `C:\path` 会被 `C:` 后面那个冒号
# 切成两段，表现是一个技能都装不上（启动日志里有 warn）。用相对仓库根的路径。
SKILL_DIRS=builtin-skills:managed-skills
# skill-libs 在**沙盒容器内**的路径（worker 镜像里是 /opt/ap/skill-libs），
# 不是你本机的路径 —— 它注入给技能脚本用
SKILL_LIBS_DIR=/opt/ap/skill-libs

# ---- 用户工作空间 ----
# 跨 run 存活的那份数据（会话工作区 + 用户自建技能）。必须是绝对路径。
# 留空 = 整体关闭：模型在沙盒里做出来的技能会随 slot 一起销毁，
# "帮我做个技能"这件事在本地就验证不了。
# USER_WORKSPACE_ROOT=/absolute/path/to/ap-workspace
# USER_WORKSPACE_QUOTA_BYTES=209715200

# ---- 功能开关 ----
MEMORY_ENABLED=1
# 额外起一次模型调用去抓事实的兜底开关，默认关（写记忆走 memory 工具，成本为 0）
MEMORY_CAPTURE=0
PROJECTS_ENABLED=1
CRON_ENABLED=1
# ⚠️ 必须只有一个副本承担调度。本地只有一个进程，开着就行
CRON_SCHEDULER=1

# ---- 作品（artifact）----
ARTIFACTS_ENABLED=1
ARTIFACT_MAX_BYTES=524288
ARTIFACT_MAX_FILES=40
ARTIFACT_MAX_VERSIONS=20
# 预览 iframe 允许加载的外部源（逗号分隔）。**默认空 = 完全离线**：
# 那段 HTML 是模型现写的，能出网就意味着能把页面里的东西带出去。
# Vue 与 mermaid 的运行时是前端自带的，不需要配 CDN。
ARTIFACT_ALLOWED_ORIGINS=

# ---- 并发与限制 ----
MAX_CONCURRENT_RUNS=8
MAX_RUNS_PER_USER=2
RUN_TIMEOUT_MS=600000
# 只有 /v1/chat/stream 单独一档，因为附件以 base64 进 JSON
REQUEST_BODY_LIMIT_BYTES=262144
REQUEST_BODY_LIMIT_CHAT_BYTES=12582912

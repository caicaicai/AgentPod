# ── 存储 ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# 本地开发不想起 Redis 时置 1，不配 REDIS_URL 的前提下用进程内存顶替
# SANDBOX_DEV_MEMORY_STORE=1

# ── 核心 ─────────────────────────────────────────────
SANDBOX_TICKET_SECRET=your-shared-hmac-secret
SANDBOX_ENV=default

# ── 心跳与判活 ───────────────────────────────────────
# SANDBOX_HEARTBEAT_MS=10000
# SANDBOX_STALE_MS=30000

# ── 票据 ─────────────────────────────────────────────
# SANDBOX_TICKET_TTL_MS=60000

# ── 调度 ─────────────────────────────────────────────
# SANDBOX_CANDIDATES=3
# SANDBOX_MAX_LEASES_PER_USER=0

# ── 出站策略 ─────────────────────────────────────────
# SANDBOX_EGRESS_MODE=allowlist
# SANDBOX_EGRESS_ALLOW=
# SANDBOX_EGRESS_LEASE_ALLOW=

# ── 管理台 ───────────────────────────────────────────
# SANDBOX_CONSOLE_ADMINS=user1,user2
# SANDBOX_CONSOLE_EXEC=0
# SANDBOX_CONSOLE_SESSION_MS=900000

# ── 产物对象存储 (S3 兼容) ───────────────────────────
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# SANDBOX_ARTIFACTS_OSS_BUCKET=fs-public
# SANDBOX_ARTIFACTS_OSS_REGION=us-east-1
# SANDBOX_ARTIFACTS_OSS_ENDPOINT=https://s3.us-east-1.amazonaws.com
# SANDBOX_ARTIFACTS_PREFIX=fod/sandbox-artifacts
# SANDBOX_ARTIFACTS_PUT_EXPIRES_SEC=900
# SANDBOX_ARTIFACTS_GET_EXPIRES_SEC=604800
# SANDBOX_ARTIFACTS_MAX_BYTES=209715200

# ── API 鉴权 ────────────────────────────────────────
# 逗号分隔的安全令牌列表
API_SECURITY_CODES=code-for-nodes,code-for-callers

# ── 管理台登录 ───────────────────────────────────────
# 内置用户名:密码，逗号分隔。必须配置才能登录管理台
CONSOLE_USERS=admin:changeme
# 会话令牌签名密钥（不配则复用 SANDBOX_TICKET_SECRET）
# SESSION_SECRET=your-session-secret
# 会话有效期（小时），默认 24
# SESSION_TTL_HOURS=24

# ── 服务器 ───────────────────────────────────────────
# PORT=3000
# HOST=0.0.0.0
# STATIC_DIR=web/dist

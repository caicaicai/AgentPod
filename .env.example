# 复制成 .env 用。三条语义：
#   1. **真实环境变量优先于本文件** —— docker compose 或容器里设了什么，这里就覆盖不了。
#   2. 默认读 <cwd>/.env；容器里要挂到别处就设 ENV_FILE=<绝对路径>（读不到会拒绝启动）。
#   3. 值两侧的引号会被去掉，`export FOO=bar` 也认。

# ---- 服务 ----
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
# 从别的路径读配置（容器里挂配置用）。留空 = 读 <cwd>/.env
# ENV_FILE=/etc/ap/agent.env

# ---- 身份 ----
# password = 内置账号密码 + JWT 会话（推荐）
# dev      = 信任 X-Username 头（仅本地开发；NODE_ENV=production 时会拒绝启动）
AUTH_MODE=password

# ---- 内置密码登录（AUTH_MODE=password 时生效）----
#
# 用户名:密码，逗号分隔。密码里可以有冒号，不能有逗号。
# 用户名只允许字母、数字、点、下划线、连字符，不超过 64 字符。
#
# ⚠️ 这个变量现在只用于**首次播种**：启动时把里面的账号补进账号存储
# （已存在的不动，所以用户改过的密码不会被一次重启打回原样）。之后加人改密
# 走界面或 /v1/admin/users 接口，密码只以 scrypt 派生结果落库，
# 不再有明文躺在环境变量、docker inspect 输出和 CI 变量面板里。
#
# 全新部署时，这里的**第一个**账号会被设成管理员。
# CONSOLE_USERS=admin:changeme,user1:mypassword
#
# 开放自助注册。**默认关** —— 账号在这里等于"能跑模型、能开沙盒"，
# 让陌生人自己开号必须是显式打开的，而不是默认能力。
# 打开后第一个注册的人是管理员（全新部署里总得有人能管别人）。
AUTH_ALLOW_REGISTER=0
# 会话令牌签名密钥。不配则自动生成（进程重启后所有会话失效）
# SESSION_SECRET=your-session-secret
# 会话有效期（小时），默认 24
# SESSION_TTL_HOURS=24

# 服务端固定登录态（本地调试用）；生产留空
FALLBACK_COOKIE=

# ---- 模型 ----
# platform = 从 /ap/llminfo 取清单与用户 llmToken
# db       = 管理员在控制台里配的那份清单（存数据库），按**用户分组**开放
# direct   = 环境变量里一个共享端点（仅本地联调，生产拒绝启动，见文件末尾）
# faux     = 假模型，用于离线开发与测试，不发任何外部请求
LLM_MODE=platform
LLM_CACHE_TTL_MS=300000

# ---- LLM_MODE=db：模型清单存数据库，管理台维护 ----
#
# 配好之后管理员在「管理员控制台 → 模型」里加模型（名称 / 模型 ID / OpenAI 兼容
# 端点 / Key / 上下文长度 / 是否读图），改完**立刻生效，不用重启**。
# 每个模型可以限定「可用分组」，一个都不勾 = 所有人可用。
# 分组在「管理员控制台 → 分组」里建，账号在「账号」页那一列里挂上去。
#
# ⚠️ 这个模式下的 Key 是**部署自己的一把**，同一个模型上所有人共用 ——
# 与 direct 模式同类。区别在于代价补上了：用量仍按 username + model_id 记账
# （管理台的 Token 用量页照常分得清谁烧了多少），可用范围按分组收口，
# Key 不下发浏览器。仍然做不到的是**上游侧的分账**：上游看到的是一把 key。
# 需要上游按人分账，用 LLM_MODE=platform。
#
# 模型 Key 的加密密钥。留空 = 明文入库（挡它的只有数据库的访问控制，
# 与 CRON_CREDENTIAL_MODE=stored 同级，启动时会 warn 一次）。
# 配上之后新保存的 Key 用 AES-256-GCM 加密入库，挡住的是"拿到了库、
# 但没拿到进程环境"的那个人：一份被拖走的备份、一个开着的只读从库。
# ⚠️ 换掉或丢掉它，已加密的那几条就解不开了 —— 管理台上会标「解不开」，
# 那几个模型被跳过（而不是让所有人的对话一起失败）。
# LLM_CONFIG_SECRET=一段足够长的口令
# 强制认为支持读图的模型（逗号分隔，大小写敏感）。
# 平台 llminfo 的 input 没标 image 时，pi 会把工具结果里的截图**静默丢掉** ——
# 模型只收到"Screenshot captured: 11622 bytes"，然后说"我看不见"。
# 正规修法是让平台补元数据；这个是等不及时的兜底。
# 先用 /v1/models 看平台到底声明了什么：curl .../v1/models | jq '.models[]|{id,input}'
# LLM_IMAGE_MODELS=GLM-5.1

# 上限字段名：max_tokens | max_completion_tokens。留空 = 用 pi 的探测。
# 已知这个上游是**老版 OpenAI schema**（连 `developer` 角色都不认），多半要 max_tokens，
# 但目前没有直接证据 —— 上游的校验器在 messages[0] 就退出了，还没轮到检查这个字段。
# 真出现 max_completion_tokens 相关的 400 时，设成 max_tokens。
# LLM_MAX_TOKENS_FIELD=max_tokens

# -- 退避重试 --
# pi 自带这套（指数退避、重试前把失败的助手消息摘掉，所以不会重复输出、不会重跑工具），
# 这里只是把参数放出来。退避是 baseDelayMs * 2^(n-1)：默认 2s / 4s / 8s，最坏多等 14 秒。
# 调大次数前先想清楚：用户是在等一个对话框，不是在跑批。
LLM_RETRY_ENABLED=1
LLM_RETRY_MAX=3
LLM_RETRY_BASE_MS=2000
# 补充"算作可重试"的错误特征（逗号分隔，每条按正则处理，大小写不敏感）。
# 起因：pi 的判定只认 429/5xx/rate limit/timeout 这些**标准**说法，而我们的网关
# 会把上游故障包成 HTTP 400，落在正则之外。留空 = 用内置的 `Already borrowed`。
#
# ⚠️ 加特征前想清楚一件事：**判据必须是"这次失败与请求内容无关"**。
# `模型服务调用失败` 一度在这个默认值里，后来拿掉了 —— 它是网关对*任何*上游失败的
# 统一包装，第一个抓到的实例其实是永久性错误（请求把系统提示发成了 role: developer）。
# 拿它当可重试特征 = 对着必然失败的请求白等 14 秒，还多打三次上游。
# LLM_RETRY_EXTRA_PATTERNS=Already borrowed

# ---- 结构化存储：MySQL（必需）----
#
# 会话、项目、长期记忆、作品、分享/市场、定时任务、账号、定时任务凭据 —— 全在库里。
#
# 曾经有过一个 file 驱动和一个 STORAGE_DRIVER 开关，去掉了：同时维护两套后端的
# 成本落在**每一处**改动上，而文件那套永远只能是"单副本时能用"（它的读改写只在
# 进程内串行，跨副本没有锁；而且是本机磁盘，同一个人落到不同副本会看到不同的历史）。
# 展开的理由见 src/persistence/storage.js 的文件头。
#
# 表结构由 agent 启动时自动建（CREATE TABLE IF NOT EXISTS，可反复执行），
# 不需要先手工导表。一份可审阅的真相在 src/persistence/schema.sql。
#
# ⚠️ 有一样**不进库**：会话工作区与用户技能（USER_WORKSPACE_ROOT）。
# 那些要被整目录 stage 进沙盒、大小没有上限，属于共享文件系统的活。
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=agentpod
MYSQL_PASSWORD=agentpod
MYSQL_DATABASE=agentpod
# 整个进程共用一个连接池 —— 各建各的池会让这个数字变得没人算得清，
# 多副本一乘就把数据库打满。
MYSQL_CONNECTION_LIMIT=10
#
# docker compose 自带一个 mysql 服务（`docker compose up -d` 就会起）。
# 端口默认只监听回环：数据库不该因为跑了一条 compose 就暴露在局域网上。
# MYSQL_BIND=127.0.0.1
# MYSQL_ROOT_PASSWORD=agentpod-root

# ---- 会话标题 ----
#
# 会话第一轮时，让模型看着用户那句话起个标题（约 18 个汉字宽）。
# 与 MEMORY_CAPTURE 那个默认关掉的开关**不是一个量级**：那个每轮都额外调一次模型，
# 这个是**一个会话一次**、几十个 token，而且与本轮并行发出，用户感觉不到延迟。
# 关掉就退回"截取第一句话的前 24 个字"。LLM_MODE=faux 时自动跳过。
SESSION_AUTO_TITLE=1

# ---- 长期记忆（MEMORY.md）----
#
# 跨会话保留的事实清单，每轮进系统提示。个人一份，每个项目各一份。
# 存在 ap_doc 表（scope 空串=个人，否则是 projectId）。
MEMORY_ENABLED=1
#
# 写记忆默认走 memory 工具：由模型自己决定记什么，额外成本是 0（那次调用本来就要发生）。
# 下面这个是**额外**再起一次模型调用去抓事实的兜底开关，默认关。
# 打开它之前先想清楚：绝大多数轮次抓出来的是一句 NONE，而每一次都要花钱。
MEMORY_CAPTURE=0
# 打开时才有意义：最后一轮之后安静这么久才抓一次（攒批，避免一轮一次）。0 = 每轮当场抓
MEMORY_CAPTURE_QUIET_MS=180000
# 攒够这么多轮就不等静默了，立刻抓 —— 免得长对话一直攒到上下文放不下
MEMORY_CAPTURE_MAX_TURNS=10

# ---- 项目 ----
# 会话分组 + 项目级指令（每轮进系统提示）+ 项目级记忆。
PROJECTS_ENABLED=1

# ---- 作品（artifact）----
#
# 助手产出的成品（网页 / Vue 组件 / 文档 / 图 / 成段代码）不贴在对话里，而是
# **作为一组文件**单独存、单独渲染成可预览、可切版本、可下载的卡片。
# 元信息进 ap_kv（collection=artifacts），每一版的文件正文进 ap_artifact_file。
#
# 每一版都是完整快照（不是相对上一版的差量），所以清理旧版就只是 DELETE 掉那个 version ——
# 版本之间互相依赖的话，清理得先算引用，而算错的后果是某一版永远打不开。
#
# ⚠️ 表里躺的是模型生成的 HTML/JS。**任何时候都别把它当页面直接吐出去**——
# 那等于把一批由模型（也就可能由一封诱导邮件）决定内容的页面挂到你自己的域名上。
# 本服务自己从不这么干：/v1/artifacts/:id/raw 一律 text/plain 下发。
ARTIFACTS_ENABLED=1
# 单个版本**所有文件加起来**的上限。更大的东西该走沙盒工作区，不该塞进一次工具调用
ARTIFACT_MAX_BYTES=524288
# 一份作品最多几个文件。拆模块是好事，但拆到几十个就该是个仓库而不是作品了
ARTIFACT_MAX_FILES=40
# 保留多少份历史。更早的删文件目录、留元信息（版本清单上仍看得到）
ARTIFACT_MAX_VERSIONS=20
#
# 预览 iframe 允许加载的外部源，逗号分隔，形如 https://cdn.jsdelivr.net
# （必须带协议、不带路径和结尾斜杠，写错了启动就会被拦下）。
#
# ⚠️ **默认空 = 完全离线**，模型生成的页面连不上任何外部地址。这是刻意的：
# 那段 HTML 是模型现写的，而模型的输入里有邮件和网页 —— 一旦它能出网，
# "把页面里的数据发到某处"就成了一封诱导邮件能做到的事（prompt injection）。
# 要用 CDN 就在这里显式列出来，列的同时也就知道自己开了什么。
#
# 注意：Vue 与 mermaid 的运行时是**自带**的（打包在前端里），不需要配 CDN；
# 作品里除 vue 外 import 任何第三方包都会失败，这一条也写进了给模型的提示词。
#
# 另一道防线不可配：预览始终在**不带 allow-same-origin 的 sandbox iframe** 里，
# 所以那段脚本读不到本页的登录令牌。见 web/src/lib/artifact-view.js。
ARTIFACT_ALLOWED_ORIGINS=

# -- 作品分享 --
#
# 作者可以为某份作品生成一条 `/s/<token>` 的链接，**拿到链接的人不需要登录**就能打开。
# 默认关（每份作品都要作者显式点一下），但这个开关默认是开的。
#
# ⚠️ 这是本服务**唯一一条不要求身份的数据通道**。内网部署里"任何人凭链接可看"
# 可能恰恰是不能接受的 —— 链接会被转发、会进聊天记录、会被搜索引擎抓到。
# 关掉之后 /s/* 与 /v1/public/* 整块 404，已经发出去的链接一并失效。
#
# 它没有破坏上面那条不变量：分享页是**本服务自己的**页面，作品正文仍然只走 JSON，
# 由前端塞进不带 allow-same-origin 的 sandbox iframe。/v1/public/shares/:token/raw
# 与登录态那条 raw 共用同一个下发函数，一样是 text/plain + nosniff。
#
# token 是 96 bit 随机（`s_` + 24 位十六进制），猜不动，所以没有额外限流。
# 存在 ap_kv（collection=shares，owner 为空）—— 只是索引（指向谁的哪份作品）+ 访问计数，
# 权威状态在作品记录的 share 字段上。撤销以后者为准，指针残留也读不出东西。
ARTIFACT_SHARING_ENABLED=1
#
# 作品市场：公开的广场，列出所有**显式发布**到市场的作品（`/market`，同样免登录）。
# 与上面那个是两个决定：生成分享链接 ≠ 上广场 —— 私发一条链接给同事，
# 和"我愿意让所有人看见"，中间隔着一个人的意愿。合成一个开关的话前者会静悄悄变成后者。
# 关掉之后分享链接照常，只是没有那个所有人都能翻到的入口。
ARTIFACT_MARKET_ENABLED=1

# ---- 定时任务 ----
# 接口开关。关掉之后连看都看不到
CRON_ENABLED=1
# 本副本是否**承担调度**。⚠️ 必须只有一个副本打开：占坑只在进程内串行，
# 两个副本同时 tick 会把同一个任务点两次。
CRON_SCHEDULER=1
CRON_TICK_MS=30000
#
# -- 无人值守时的凭据来源（默认 none，开之前请读 src/cron/credentials.js 开头）--
#
# 现在的凭据模型是透传：用调用方带来的登录态去换模型访问权。这条路只在
# **人坐在浏览器前面时**成立 —— 凌晨三点触发的定时任务没有浏览器，也就没有登录态。
#
#   none    不存任何凭据。LLM_MODE=platform 时定时任务触发会记 needs_reauth 并跳过
#   stored  用户在网页上创建/修改定时任务时，把那一刻的登录态存进 ap_doc（kind=cron-credential）
#
# ⚠️ stored 是一道明确的口子，性质与 SANDBOX_INJECT_ME_TOKEN 同级：拿到库就等于拿到
# 这些人的登录态。平台支持服务端代持（tokenGrant/refreshToken）之后应改回 none。
CRON_CREDENTIAL_MODE=none

# ---- 沙盒 ----
# manager = 向 sandbox-manager 要节点 + 短期票据，直连拿到的那一个（**推荐**）
# http    = 直接派发到某个 worker 地址，靠一把长期共享密钥鉴权
# local   = 在本进程内执行命令（仅本地开发；NODE_ENV=production 时会拒绝启动）
# none    = 不提供任何执行工具
SANDBOX_MODE=manager
SANDBOX_TIMEOUT_MS=120000

# -- 把 me_token 注入沙盒（默认关）--
#
# 开了之后用户的 me_token 会以 ME_TOKEN 环境变量进沙盒，让技能可以使用用户身份调用外部服务。
#
# ⚠️ 代价：沙盒里跑的是模型现写的代码，输入（邮件正文、网页、别人发布的技能）都不可信。
# 开了之后一封诱导邮件就可能让它把 token echo 进回答、或写进会同步到共享存储的文件。
SANDBOX_INJECT_ME_TOKEN=0

# -- manager 模式 --
# 与 http 模式的实质区别是**本进程不再持有长期凭据**：拿到的票据绑定单个节点、
# 60 秒过期、只能换一次租约。协议见 sandbox-manager/docs/PROTOCOL.md §3。
# 沙盒产物直传对象存储（artifacts）也只在这个模式下可用 —— OSS 凭据在管理端，
# agent 只替沙盒转一次换取地址的调用。
SANDBOX_MANAGER_URL=http://manager:3000
# 调度接口的安全令牌
SANDBOX_MANAGER_CODE=
# 只调度到这个资源池的节点
SANDBOX_POOL=default
# 要求节点具备浏览器能力。默认 false（所有节点都装了 Chromium，不需要挑）；
# 将来混入纯 CPU 节点时再打开，代价是可用节点变少。
SANDBOX_NEED_BROWSER=0
# 持有租约期间周期性续期。关掉的话，模型长思考十几分钟就会撞上 idle 回收，
# 用户回来时工作区已经没了。排查"槽位为什么不释放"时才临时关。
SANDBOX_KEEPALIVE=1
# 命令走异步任务 + 断线续传（节点支持时）。关掉退回同步流，网络抖一下
# 一条跑了四分钟的 npm install 就白跑，还在工作区留下半装完的 node_modules。
SANDBOX_EXEC_ASYNC=1

# -- http 模式 --
# worker 的 Service 地址。租约响应会回报具体副本地址，之后 exec 直连那一个。
SANDBOX_URL=http://sandbox-worker:8080
# 与 worker 共享的密钥。没有它，任何能连到 worker 端口的人都能执行命令。
# 这个模式下生产必填；manager 模式下不需要（执行权限来自票据）。
SANDBOX_TOKEN=

# ---- 真模型联调（LLM_MODE=direct，生产拒绝启动）----
# 直连任意 OpenAI 兼容端点，其余链路与 platform 模式完全一致。
# 用途见 docs/E2E-LOCAL.md：本地用真模型验证"技能到底能不能被用起来"。
# LLM_DIRECT_BASE_URL=https://api.openai.com/v1
# LLM_DIRECT_API_KEY=sk-xxx
# LLM_DIRECT_MODEL=gpt-4o-mini,gpt-4o    # 逗号分隔，第一个是默认；大小写敏感
# LLM_DIRECT_INPUT=text,image

# ---- 技能 ----
# 冒号分隔的目录列表，pi 原生识别 SKILL.md。启动时读一次。
# 目录里每个技能一个子目录（SKILL.md + scripts/），整棵会在第一次用沙盒时
# 铺到工作区的 skills/<name>/ 下 —— SKILL.md 里的 `cd skills/<name>` 就是这么对上的。
# **留空 = 一个技能都不宣告**（启动日志里有 warn），不是静默降级。
#
# 两个目录，来源不同、维护方式也不同（见 builtin-skills/README.md）：
#   managed-skills/  桌面端仓库的镜像同步产物，`bin/sync-skills.sh` 会 --delete 覆盖
#   builtin-skills/  改写自桌面端扩展包的平台技能，真源就在本仓库，手工维护
# **漏掉后一段不报错**，表现是那几个技能在 /v1/skills 里查无此人。
SKILL_DIRS=/app/managed-skills:/app/builtin-skills
# 沙盒镜像里 skill-libs 的路径，注入为 ap_SKILL_LIBS_DIR
SKILL_LIBS_DIR=/opt/ap/skill-libs

# ---- 联网搜索（web_search 工具） ----
# 搜索 API 网关地址。
# WEB_SEARCH_HOST=https://api.search.example.com
# 租户标识
# WEB_SEARCH_TENANT_CODE=DEFAULT

# ---- 用户工作空间 ----
# 挂在**所有 agent 节点**上的同一份共享存储。留空 = 整体关闭（行为与没有这个功能时一致）。
# ⚠️ worker 上不要挂：沙盒的隔离靠"别人的东西根本不在那儿"，不靠文件权限位，
#    而 slot 的 uid 是槽位序号不是人（详见 src/workspace/store.js 开头）。
#
#   <root>/users/<username>/skills/{created,installed}/   个人技能，stage 进沙盒但**不回写**
#   <root>/users/<username>/sessions/<key>/workspace/     会话工作区，stage + 回写
#
# 没有它，模型在沙盒里做出来的技能会随 slot 销毁一起蒸发（"帮我做个技能"不成立）。
USER_WORKSPACE_ROOT=
# 每人总占用上限。共享盘一般不给 per-user quota，没有它就是"一个人写满，所有人挂"
USER_WORKSPACE_QUOTA_BYTES=209715200
USER_WORKSPACE_MAX_FILES=2000
# 单轮同步回来的文件数上限，防止一次 npm install 把几万个文件搬上共享盘
USER_WORKSPACE_MAX_SYNC_FILES=500

# ---- 并发与超时 ----
MAX_CONCURRENT_RUNS=8
MAX_RUNS_PER_USER=2
RUN_TIMEOUT_MS=600000
REQUEST_BODY_LIMIT_BYTES=262144

# ---- 前端 ----
# 对话界面（/）。这是产品自己的前台页面，生产要开。
# 只有把界面另起一个独立前端工程时才关掉它。
WEB_UI=1
# 开发控制台（/console）。生产必须为 0：它会暴露隔离自检等调试端点。
# 与 WEB_UI 是两个开关，因为性质不同：一个是前台，一个是调试面板。
DEV_CONSOLE=1
